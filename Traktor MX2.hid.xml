    <group label="Jog wheels">
      <option
        variable="jogWheelSensivity"
        label="Jogging and nudging sensitivity"
        type="enum">
        <value label="Low">0.25</value>
        <value label="Medium" default="true">0.5</value>
        <value label="High">0.75</value>
        <description>
          Sensitivity for turning the wheel by touching only the outer ring. Higher settings will allow for faster jogging and nudging movement.
        </description>
      </option>
      <option
        variable="jogWheelAlpha"
        label="Movement smoothing"
        type="enum">
        <value label="Low">0.25</value>
        <value label="Medium" default="true">0.5</value>
        <value label="High">0.75</value>
        <description>
          Controls jog wheel's movement smoothing. Low setting produces smooth but less responsive movement, while high setting produces snappy but noisier movement.
        </description>
      </option>
      <option
        variable="jogWheelEpsilon"
        label="Input dead zone"
        type="enum">
        <value label="Low">1e-5</value>
        <value label="Medium" default="true">1e-6</value>
        <value label="High">1e-7</value>
        <description>
          Adjusts the jog wheel's input dead zone. Higher values ignore more subtle movements, but can make the wheel feel less responsive.
        </description>
      </option>
      <option
        variable="jogWheelSeekSpeed"
        label="Quick seek speed"
        type="enum">
        <value label="Low">5e4</value>
        <value label="Medium">1e5</value>
        <value label="High" default="true">1e6</value>
        <description>
          Sets the jog wheel's quick seek speed. To activate quick seek, hold 'Shift' while turning the wheel. In turntable mode, turn the wheel from the outer ring.
        </description>
      </option>
    </group>
    <group label="Controls">
      <option
        variable="softTakeover"
        label="Use soft takeover for knobs and faders"
        type="boolean"
        default="true">
        <description>
          Ignore knob and fader movements until they pass the current on-screen position. This can prevent sudden level jumps when physical and on-screen controls are out of sync.
        </description>
      </option>
      <option
          variable="rateFaderSnap"
          label="Rate fader midpoint snapping"
          type="enum">
          <value label="Off" default="true">0</value>
          <value label="Low">100</value>
          <value label="High">300</value>
          <description>
            Range over which rate faders automatically snap to the midpoint.
          </description>
      </option>
      <option
          variable="longPressTimeout"
          label="Long press timeout"
          type="integer"
          min="100"
          max="1000"
          step="1"
          default="300">
          <description>
            Time in milliseconds required to hold a button before a long press is registered.
          </description>
      </option>
    </group>
