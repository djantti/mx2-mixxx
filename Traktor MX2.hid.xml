  <settings>
    <group label="Deck lighting">
      <option
        variable="colorTheme"
        label="Color theme"
        type="enum">
        <value label="Custom">Custom</value>
        <value label="Default" default="true">Default</value>
        <value label="Frostbite">Frostbite</value>
        <value label="Mojito">Mojito</value>
        <value label="Synthwave">Synthwave</value>
        <description>
          Sets the color theme for button LEDs. Select 'Custom' to use colors defined in the 'Custom color theme' section.
        </description>
      </option>
      <option
        variable="matchPadColors"
        label="Match pad colors to on-screen colors"
        type="boolean"
        default="true">
        <description>
          Use on-screen colors for pad LEDs while in hotcues or stems mode. Normal theme colors will be used if this option is off.
        </description>
      </option>
      <option
        variable="brightMeterSegments"
        label="Use bright VU meter segments"
        type="boolean"
        default="true">
        <description>
          Use full brightness for VU meter LED segments. Dimmed LED brightness will be used if this option is off.
        </description>
      </option>
      <option
        variable="enableBottomLeds"
        label="Enable bottom panel light effects"
        type="boolean"
        default="true">
        <description>
          Use bottom panel LEDs to indicate deck state. Effect colors can be customized in the 'Bottom panel colors' section.
        </description>
      </option>
    </group>
